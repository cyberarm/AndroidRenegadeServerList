<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/server_item_padding_left_right"
        android:layout_marginEnd="@dimen/server_item_padding_left_right"
        android:layout_marginBottom="@dimen/server_item_margin"
        android:background="@drawable/shape_card"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/server_item_padding"
            android:layout_marginTop="@dimen/server_item_padding"
            android:layout_marginEnd="@dimen/server_item_padding"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/team_faction_icon"
                android:layout_width="@dimen/server_icon_size"
                android:layout_height="@dimen/server_icon_size"
                android:background="@drawable/application_default_image" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/server_item_padding_left_right"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/team_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:text="{TEAM_NAME}" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textView21"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/server_item_padding_left_right"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/server_info_score" />

                        <TextView
                            android:id="@+id/textView22"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/server_item_padding_left_right"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/server_info_kills" />

                        <TextView
                            android:id="@+id/textView23"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/server_item_padding_left_right"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/server_info_deaths" />

                        <TextView
                            android:id="@+id/textView24"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/server_info_players" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/team_score"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/server_item_padding_left_right"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif"
                            android:maxLines="1"
                            android:text="{200,200}" />

                        <TextView
                            android:id="@+id/team_kills"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/server_item_padding_left_right"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif"
                            android:maxLines="1"
                            android:text="9,999" />

                        <TextView
                            android:id="@+id/team_deaths"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/server_item_padding_left_right"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif"
                            android:maxLines="1"
                            android:text="4,500" />

                        <TextView
                            android:id="@+id/team_player_count"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif"
                            android:maxLines="1"
                            android:text="127/127" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/team_separator"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="@dimen/server_item_padding"
            android:layout_marginBottom="@dimen/server_item_padding"
            android:background="?attr/custom_row_item_background"
            android:orientation="vertical"></LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/server_item_padding"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/server_team_rows"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/server_item_padding_left_right"
                        android:paddingEnd="@dimen/server_item_padding_left_right">

                        <TextView
                            android:id="@+id/textView2400"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/server_item_padding_left_right"
                            android:layout_weight="3"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/server_info_name" />

                        <TextView
                            android:id="@+id/textView2100"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/server_item_padding_left_right"
                            android:layout_weight="1.25"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/server_info_score" />

                        <TextView
                            android:id="@+id/textView2200"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/server_item_padding_left_right"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/server_info_kills" />

                        <TextView
                            android:id="@+id/textView2003"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/server_item_padding_left_right"
                            android:layout_weight="1.25"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/server_info_deaths" />


                        <TextView
                            android:id="@+id/textView2202"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/server_item_padding_left_right"
                            android:layout_weight="0.8"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/server_info_ping" />

                        <TextView
                            android:id="@+id/textView2023"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.5"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/server_info_time_elapsed" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>