<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="@dimen/server_item_padding_left_right"
    android:paddingTop="@dimen/server_item_padding"
    android:paddingEnd="@dimen/server_item_padding_left_right"
    android:paddingBottom="@dimen/server_item_padding">

    <TextView
        android:id="@+id/player_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/server_item_padding_left_right"
        android:layout_weight="3"
        android:fontFamily="sans-serif"
        android:maxLines="1"
        android:text="{SteelGhostSteelGhost}" />

    <TextView
        android:id="@+id/player_score"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/server_item_padding_left_right"
        android:layout_weight="1.25"
        android:fontFamily="sans-serif"
        android:maxLines="1"
        android:text="99,999" />

    <TextView
        android:id="@+id/player_kills"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/server_item_padding_left_right"
        android:layout_weight="1"
        android:fontFamily="sans-serif"
        android:maxLines="1"
        android:text="4,500" />

    <TextView
        android:id="@+id/player_deaths"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/server_item_padding_left_right"
        android:layout_weight="1.25"
        android:fontFamily="sans-serif"
        android:maxLines="1"
        android:text="9,999" />


    <TextView
        android:id="@+id/player_ping"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/server_item_padding_left_right"
        android:layout_weight="1"
        android:fontFamily="sans-serif"
        android:maxLines="1"
        android:text="9,999" />

    <TextView
        android:id="@+id/player_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.5"
        android:fontFamily="sans-serif"
        android:maxLines="1"
        android:text="00:00:00" />

</LinearLayout>
