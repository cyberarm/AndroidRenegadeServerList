        <item name="colorPrimary">@color/dark_5</item>
        <item name="colorPrimaryVariant">@color/red_1</item>
        <item name="colorOnPrimary">@color/dark_5</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/green_1</item>
        <item name="colorSecondaryVariant">@color/green_5</item>
        <item name="colorOnSecondary">@color/dark_5</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
        <item name="custom_card_background">@color/background_light</item>
    </style>
</resources>