<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.RenegadeServerList" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:fitsSystemWindows">true</item>

        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/dark_5</item>
        <item name="colorPrimaryVariant">@color/red_1</item>
        <item name="colorOnPrimary">@color/dark_5</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/green_1</item>
        <item name="colorSecondaryVariant">@color/green_5</item>
        <item name="colorOnSecondary">@color/dark_5</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/navigation_background_light</item>
        <item name="android:navigationBarColor">@color/navigation_background_light</item>
        <!-- Text color -->
        <item name="android:textColorPrimary">@color/dark_5</item>
        <item name="android:textColor">@color/dark_5</item>
        <!-- Customize your theme here. -->
        <item name="custom_navigation_background">@color/navigation_background_light</item>
        <item name="custom_row_item_background">@color/row_item_background_light</item>
        <item name="custom_card_background">@color/background_light</item>
    </style>
</resources>